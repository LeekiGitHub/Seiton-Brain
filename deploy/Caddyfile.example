# Beispiel-Caddy-Konfiguration fuer VPS (E20-2 / E9-3).
#
# Siehe auch docs/remote-access.md (nginx, Cloudflare Tunnel, SSH).
# 1. Domain per DNS auf die VPS-IP zeigen lassen
# 2. Caddy installieren: https://caddyserver.com/docs/install
# 3. Diese Datei nach /etc/caddy/Caddyfile kopieren und Domain anpassen
# 4. sudo systemctl reload caddy
# 5. PUBLIC_URL=https://brain.example.com ./scripts/register-telegram-webhook.sh

brain.example.com {
	encode gzip

	# Setup-Wizard und API-Doku niemals oeffentlich machen (E27-1):
	# /setup schreibt Secrets in die .env. Admin-Zugriff nur lokal auf dem
	# Server (SSH-Tunnel: ssh -L 8000:127.0.0.1:8000 user@vps).
	@blocked path /setup* /api/setup/* /docs* /redoc* /openapi.json
	respond @blocked 403

	reverse_proxy 127.0.0.1:8000
}
