# Telegram (optional — leer lassen = Telegram deaktiviert, E19-1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Komma-separierte Liste deiner Telegram-User-IDs (z.B. "12345678,87654321").
# Wenn gesetzt, akzeptiert der Bot nur Nachrichten von diesen IDs.
# Eigene ID herausfinden: in Telegram /start an @userinfobot schicken.
# Leer lassen -> Allowlist deaktiviert (nicht empfohlen für öffentliche Webhooks).
TELEGRAM_ALLOWED_USER_IDS=

# Chat-ID fuer Admin-Fehler-DMs bei dauerhaften Worker-Fehlern (optional).
# Leer = nur Log, keine Telegram-Benachrichtigung an den Admin.
# Eigene ID: /start an @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=

# Long-Polling-Modus (Alternative zum Webhook — keine oeffentliche URL noetig).
# Greift nur, wenn der Poller laeuft: `docker compose --profile polling up`
# oder lokal `python -m app.telegram.polling`. Long-Poll-Fenster in Sekunden.
TELEGRAM_POLLING_TIMEOUT=25

# Maximale Groesse einer Sprachnachricht in Bytes (E6-1). Default 10 MB.
TELEGRAM_VOICE_MAX_BYTES=10485760
# Temporaerer Voice-Cache bis Verarbeitung ok (E6-2). Docker: /data/voice-cache
TELEGRAM_VOICE_CACHE_DIR=temp/voice

# Optional: Pfad zu vault_config.yaml (E4-3). Leer = <Vault>/vault_config.yaml
# SEITON_VAULT_CONFIG=

# LLM — choose one (siehe docs/llm-providers.md)
LLM_PROVIDER=openai          # or: ollama
OPENAI_API_KEY=...
OPENAI_MODEL=gpt-4o-mini
# UI-Auth (E23-1). Leer = Web-UI nur von localhost. Gesetzt = Login-Pflicht
# (Session-Cookie) — Remote-Zugriff dann nur hinter TLS, docs/remote-access.md.
UI_PASSWORD=
# Session-Cookie Secure-Flag (E27-3). true = Cookie nur über HTTPS senden
# (hinter TLS-Proxy setzen). Localhost/HTTP: false belassen.
UI_COOKIE_SECURE=false
# Max. Groesse fuer Telegram-Dokumente/Fotos (E22-2). Bot-API-Limit: 20 MB.
TELEGRAM_DOCUMENT_MAX_BYTES=20971520
# Whisper Sprach-Hint (E6-3), ISO-639-1 z. B. de / en. Leer = Auto-Detect.
WHISPER_LANGUAGE=
# Transkription (E6-4): openai (Default) oder whisper.cpp — siehe docs/whisper-cpp.md
WHISPER_PROVIDER=openai
WHISPER_CPP_BINARY=whisper-cli
WHISPER_CPP_MODEL=models/ggml-base.bin
WHISPER_CPP_FALLBACK_OPENAI=true
# Max. Notizen im Classify-Prompt nach Token-Prefilter (E5-2). Default 30.
SEITON_LLM_NOTE_LIMIT=30
# Prompt-Version (E4-4): prompts/{classify,router,writer,linker}.v1.txt — in DB gespeichert.
SEITON_PROMPT_VERSION=v1
# Spezialisierte LLM-Rollen (E7-3): Router→Writer→Linker. false = Ein-Shot classify.
SEITON_LLM_ROLES_ENABLED=true
# Ollama (nur wenn LLM_PROVIDER=ollama). Embeddings bleiben OpenAI; Whisper lokal möglich (E6-4).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Semantische Suche (E17-2). Aus = nur Keyword-Suche, keine Embedding-Kosten.
# An = Notizen werden beim Schreiben/Sync embedded; nach dem Aktivieren einmal
# einen Vault-Sync laufen lassen, um Bestandsnotizen nachzurüsten (Backfill).
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
# Chunking fuer Retrieval (E18-4). Lange Docs → N Abschnitte in vault_chunk.
SEITON_CHUNK_SIZE=1500
SEITON_CHUNK_OVERLAP=200
# Vault-Index Sync (E28-1). Celery Beat Intervall in Sekunden; 0 = aus.
# Obsidian-Edits erscheinen nach höchstens diesem Intervall in Suche/RAG.
SEITON_INDEX_SYNC_INTERVAL_SECONDS=60
# OCR (E18-5, optional). Braucht System-Tesseract + pip install -r requirements-ocr.txt
# Siehe docs/ocr.md
SEITON_OCR_ENABLED=true
SEITON_OCR_LANG=deu+eng
# Vision-LLM fuer reine Fotos (E18-6). Default aus (API-Kosten). Siehe docs/vision.md
SEITON_VISION_ENABLED=false
SEITON_VISION_MODEL=
# OS-Keystore fuer Secrets (E16-5). true = Keys nicht Klartext in .env;
# Start dann: ./scripts/seiton-up.sh  (pip install -r requirements-keyring.txt)
SEITON_KEYRING=false

# Obsidian — point at your personal vault, not vault.example/
OBSIDIAN_VAULT_HOST_PATH=/Users/you/Obsidian/Seiton-Brain
OBSIDIAN_VAULT_PATH=/vault   # inside Docker; use host path when running locally
# Vault-Backend (E15-1/E15-3). filesystem = normaler Markdown-Ordner,
# git = Commit pro Note; optionaler Push auf Remote.
VAULT_BACKEND=filesystem
VAULT_GIT_PUSH=false
VAULT_GIT_REMOTE=origin
# Optional: fixer Ziel-Branch beim Push, sonst aktueller Branch
VAULT_GIT_BRANCH=
VAULT_GIT_AUTHOR_NAME="Seiton Brain"
VAULT_GIT_AUTHOR_EMAIL="seiton@example.invalid"

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/seitonbrain

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# REST API (/v1/*). Leer lassen = API deaktiviert. Fuer n8n/externe Tools setzen:
SEITON_API_KEY=change-me-to-a-long-random-string
# Header bei Requests: X-Seiton-Api-Key: <derselbe Wert>

# Outbound Webhooks (optional). Leer = deaktiviert.
# n8n: Webhook-Trigger-Node — Event-Typ im JSON-Feld "event" filtern.
SEITON_WEBHOOK_URL=

# Logging (optional)
LOG_LEVEL=INFO
# true = JSON (Docker/Production), false = lesbares Text-Format lokal
LOG_JSON=true

# Deploy-Modus (gesetzt durch install.sh / deploy-vps.sh): consumer | vps
# SEITON_DEPLOY_MODE=consumer

# Kommerzielle Lizenz (E21-1). Leer = keine Lizenz (MIT/Portfolio-Default).
# Format: SEITON1.<payload>.<signature> — siehe docs/licensing.md
SEITON_LICENSE_KEY=
# false = Start ohne Lizenz (öffentliches Repo). true = nur mit gültigem Key.
SEITON_LICENSE_REQUIRED=false

# Debug: OpenAPI /docs auch ohne SEITON_API_KEY (nur localhost, E13-4).
SEITON_DEBUG=false